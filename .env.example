# Copy to .env locally. Never use a production/shared schema for tests.
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livora_dev
DB_USER=livora_migrator
DB_PASSWORD=replace_with_local_password
# Remote DBs require a CA file and certificate verification; local loopback may omit it.
DB_TLS_CA_FILE=
DB_CONNECT_TIMEOUT_MS=10000

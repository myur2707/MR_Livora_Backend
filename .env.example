# Copy to .env locally. Never use a production/shared schema for tests.
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livora_dev_local
DB_USER=livora_migrator
DB_PASSWORD=replace_with_local_password
# Remote DBs require a CA file and certificate verification; local loopback may omit it.
DB_TLS_CA_FILE=
DB_CONNECT_TIMEOUT_MS=10000

# Runtime uses a different, restricted account. Never reuse the migration account.
APP_DB_USER=livora_app
APP_DB_PASSWORD=replace_with_runtime_password
HOST=127.0.0.1
PORT=3000
# Serve Angular and /api/v1 under this same origin. Development uses Angular's proxy.
APP_ORIGIN=http://127.0.0.1:4200
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_random_hex_secret
# Production behind one trusted reverse proxy only; blank means trust no proxy.
TRUSTED_PROXY_IP=
# Existing SMTP account; no paid provider integration or public reset-link logging.
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=replace_with_sender@example.invalid
# Only the explicit development seed command reads this; never a production default.
DEV_AUTH_PASSWORD=replace_with_unique_development_password
